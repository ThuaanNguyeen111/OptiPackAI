@startuml
' Standard PlantUML compatibility edition, converted from sag (1).drawio.
' Self-contained: native PlantUML shapes; original-color logos embedded below.
' Database and Cache retain cylinder shapes; edge labels and directions are preserved.
' PlantUML automatically computes the layout; draw.io coordinates cannot be pinned here.

left to right direction
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam shadowing false
skinparam roundCorner 8
skinparam linetype ortho
skinparam nodesep 40
skinparam ranksep 120
skinparam packageStyle rectangle
skinparam ArrowColor #444444
skinparam ArrowFontColor #222222
skinparam ArrowFontSize 11
skinparam rectangle {
  BackgroundColor #FFFFFF
  BorderColor #444444
  FontColor #222222
}
skinparam database {
  BackgroundColor #FFFFFF
  BorderColor #444444
  FontColor #222222
}
skinparam package {
  BackgroundColor #FFFFFF
  BorderColor #444444
  FontColor #222222
  FontStyle bold
}

hide stereotype

' Embedded logos; edit component names and arrows in the sections below.
!define LOGO_WEB <img:data:image/png;base64,> <img:data:image/png;base64,>
!define LOGO_APP <img:data:image/png;base64,>
!define LOGO_API <img:data:image/png;base64,>
!define LOGO_OPT <img:data:image/png;base64,> <img:data:image/png;base64,>
!define LOGO_DB <img:data:image/png;base64,>
!define LOGO_CACHE <img:data:image/png;base64,>
!define LOGO_AI <img:data:image/png;base64,>


skinparam defaultTextAlignment center
' Components
package "Frontend" as FRONTEND {
  rectangle "LOGO_WEB\n<b>Web</b>\n<size:12>React / Vite</size>" as WEB
  rectangle "LOGO_APP\n<b>Mobile</b>\n<size:12>Flutter</size>" as APP
}

package "Backend" as BACKEND {
  rectangle "<color:white>MMMMMMMMMMMMMMMMMMMMMMMM</color>\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\nLOGO_API\n<b>API Server</b>\n<size:12>NestJS</size>\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n" as API
  rectangle "LOGO_OPT\n<b>Packing Optimizer</b>\n<size:12>Python / FastAPI</size>" as OPT
}

package "Storage" as STORAGE {
  database "LOGO_DB\n<b>Database</b>\n<size:12>MongoDB Atlas</size>" as DB
  database "LOGO_CACHE\n<b>Cache</b>\n<size:12>Redis</size>" as CACHE
}

package "External Services" as EXTERNAL {
  rectangle "\n\n\n<b>Marketplaces</b>\n<size:12>Lazada / AURELLE</size>\n\n\n" as MKT
  rectangle "\n\n\n<b>Shipping</b>\n<size:12>GHN</size>\n\n\n" as SHIP
  rectangle "LOGO_AI\n<b>AI</b>\n<size:12>Groq</size>" as AI
}

' Connections: solid requests/events and dashed responses/ACKs.
WEB --> API : HTTPS
WEB <.. API : HTTPS
APP --> API : HTTPS
APP <.. API : HTTPS
API -left-> OPT : Packing request · HTTP
OPT -[dashed]right-> API : Packing result
API --> DB : Query · TLS
API <.. DB
API --> CACHE : TCP
API <.. CACHE
API --> MKT : HTTPS
API <.. MKT : HTTPS
API <-- MKT : Webhook
API ..> MKT : ACK
API --> SHIP : HTTPS
API <.. SHIP : HTTPS
API <-- SHIP : Webhook
API ..> SHIP : ACK
API --> AI : HTTPS
API <.. AI : Packing guide

' Layout hints only
APP -[hidden]right-> WEB
CACHE -[hidden]right-> DB
AI -[hidden]right-> SHIP
SHIP -[hidden]right-> MKT
MKT -[hidden]right-> CACHE

@enduml
