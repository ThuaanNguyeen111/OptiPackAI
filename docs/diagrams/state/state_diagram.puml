@startuml state_diagram
' Source of truth: be/src/modules/orders/enums/order-status.enum.ts
' Sync and mapping: be/src/modules/orders/orders.service.ts (syncShopOrders)
'                   be/src/modules/orders/mappers/lazada-order.mapper.ts
'                   be/src/modules/storefront/aurelle-open-api.mapper.ts (toOpenApiStatus)
' Seller cancellation: be/src/modules/order-groups/order-groups.service.ts (sellerCancelOrder)
' Presentation overview: TO_SHIP and logistics incident states are omitted.
top to bottom direction

title Order Lifecycle

skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam ArrowFontSize 11
skinparam shadowing false
skinparam nodesep 25
skinparam ranksep 30
skinparam ArrowColor Black
skinparam stateBorderColor Black
skinparam stateBackgroundColor White
hide empty description

state "unpaid" as UNPAID
state "pending" as PENDING
state "topack" as TO_PACK
state "packed" as PACKED
state "ready_to_ship" as READY_TO_SHIP
state "shipped" as SHIPPED
state "delivered" as DELIVERED
state "failed_delivery" as FAILED_DELIVERY
state "shipped_back" as SHIPPED_BACK
state "shipped_back_success" as SHIPPED_BACK_SUCCESS
state "returned" as RETURNED
state "canceled" as CANCELED
state "failed" as FAILED

[*] --> UNPAID
[*] --> PENDING : COD
UNPAID -down-> PENDING : Paid
PENDING -down-> TO_PACK
TO_PACK -down-> PACKED
PACKED -down-> READY_TO_SHIP
READY_TO_SHIP -down-> SHIPPED
SHIPPED -down-> DELIVERED
DELIVERED --> [*] : Complete

PENDING -left-> CANCELED : Cancel
UNPAID -right-> FAILED

SHIPPED -left-> FAILED_DELIVERY
FAILED_DELIVERY --> SHIPPED : Retry
FAILED_DELIVERY -down-> SHIPPED_BACK
SHIPPED_BACK -down-> SHIPPED_BACK_SUCCESS
SHIPPED_BACK_SUCCESS --> RETURNED
DELIVERED --> RETURNED : Customer return
RETURNED --> [*]

@enduml
