%% Notation (same as the Report 3 template sample):
%%   yellow box  = public screen (before login)      white box   = screen after login
%%   rounded box = pop-up dialog                     thick box   = screen with several tabs (tabs in italics)
flowchart LR
  classDef pub fill:#FFF2CC,stroke:#000,stroke-width:1px,color:#0000CC
  classDef scr fill:#FFFFFF,stroke:#000,stroke-width:1px,color:#000
  classDef tab fill:#FFFFFF,stroke:#000,stroke-width:3px,color:#000
  classDef pop fill:#FFFFFF,stroke:#000,stroke-width:1px,color:#000
  classDef hub fill:#E8E8E8,stroke:#000,stroke-width:1px,color:#000

  LAND[Landing Page]:::pub --> LOGIN[Login<br/><i>e-mail / password, Google</i>]:::pub
  LOGIN --> FORGOT[Forgot Password]:::pub
  FORGOT -. e-mailed link .-> RESET[Reset Password]:::pub
  RESET --> LOGIN
  LOGIN --> MFA([Two-factor verification<br/><i>when enabled</i>]):::pop
  LOGIN -- first login --> CHPW[Change Password]:::scr
  LOGIN --> HOME
  MFA --> HOME
  CHPW --> HOME
  HOME{{Home screen by role}}:::hub


  HOME -- Store Owner --> DASH[Dashboard Overview]:::scr
    DASH --> ORD[Omnichannel Orders]:::scr --> ORDD[Order Detail]:::scr
    DASH --> GRP[Groups & Express]:::scr
    DASH --> SYNC[Order Sync Settings]:::scr
    DASH --> RET[Returns]:::scr
    DASH --> RULE[Packaging Rules]:::scr
    DASH --> MAT[Packaging Materials]:::scr
    DASH --> STAFF[Staff Directory]:::scr
    DASH --> ANA[Analytics]:::scr

  HOME -- Admin --> ADM[Admin Home<br/><i>user accounts</i>]:::scr
    ADM --> TMP([Temporary password]):::pop
    ADM --> ROLES[Roles & Permissions]:::scr
    ADM --> MKT[Marketplace Connections]:::scr --> OAUTH[Marketplace OAuth result]:::scr
    ADM --> AORD[Admin Orders]:::scr --> AORDD[Admin Order Detail]:::scr
    ADM --> ASYNC[Order Sync Settings]:::scr
    ADM --> AI[AI & Packing Settings]:::scr
    ADM --> PLANS[Admin Packing Plans]:::scr
    ADM --> AWH[Admin Warehouse<br/><i>Products: Categories & colours ·<br/>Internal SKUs · Map Lazada SKUs<br/>Warehouses: Zones & racks ·<br/>Assign SKU to bin · Stock · Picking route</i>]:::tab
    ADM --> AMAT[Packaging Materials]:::scr
    ADM --> ARET[Returns]:::scr

