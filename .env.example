# Biến dành riêng cho docker compose (KHÁC be/.env — file đó là biến của
# ứng dụng backend). Copy thành .env ở thư mục gốc nếu cần đổi mặc định.
#
#   cp .env.example .env

# --- Cổng publish ra máy host ---
BE_PORT=3000
FE_PORT=5173
STOREFRONT_PORT=3001
REDIS_PORT=6379

# --- URL backend mà TRÌNH DUYỆT gọi tới ---
# Được nhúng vào bundle FE/storefront LÚC BUILD image, đổi thì phải
# `docker compose build` lại, không chỉ restart.
VITE_API_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000

# --- CORS cho backend (khớp với 2 URL trình duyệt mở FE/storefront) ---
CORS_ORIGIN=http://localhost:5173,http://localhost:3001

# --- Redis ---
# Để trống = không đặt mật khẩu (chỉ nên dùng ở máy dev).
REDIS_PASSWORD=

# --- Chỉ dùng với profile local-db (không cần khi xài MongoDB Atlas) ---
MONGO_PORT=27017
MONGO_EXPRESS_PORT=8081
MONGO_EXPRESS_USER=admin
MONGO_EXPRESS_PASSWORD=admin123
