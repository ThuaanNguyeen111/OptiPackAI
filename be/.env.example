

# --- Server ---
PORT=3000
CORS_ORIGIN=http://localhost:5173,http://localhost:3001
CLIENT_REDIRECT_CALLBACK=http://localhost:5173/oauth-success

# --- Database ---
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/optipackai?retryWrites=true&w=majority

# --- Redis (cache trạng thái auth) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- JWT ---
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=86400
JWT_REFRESH_EXPIRES_IN=2592000

# --- Google OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# --- Email (SMTP) ---

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM_NAME=OptiPackAI
MAIL_FROM_ADDRESS=
FRONTEND_URL=http://localhost:5173
STOREFRONT_NAME=AURELLE

# Storefront admin: see storefront/README.md. Leave blank to disable login.
STOREFRONT_ADMIN_EMAIL=
STOREFRONT_ADMIN_PASSWORD_HASH=
STOREFRONT_ADMIN_JWT_SECRET=
# 22/10/2026 — true (mặc định): website CHỈ bán SKU có tồn do kho OptiPack quản (đã nối SKU nội bộ /
# kho đã nhập). SKU website tự quản hiện "Hết hàng". false = cho bán theo tồn Admin website nhập (demo cũ).
STOREFRONT_REQUIRE_OPTIPACK_STOCK=true

# --- Marketplace Integration (TikTok Shop + Lazada + Tiki) ---
TOKEN_ENCRYPTION_KEY=
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

TIKTOK_APP_KEY=
TIKTOK_APP_SECRET=
TIKTOK_SANDBOX=true
# 3 dòng dưới CHỈ cần điền khi dùng mock server tools/tiktok-mock-server, để trống dùng domain thật
TIKTOK_AUTHORIZE_BASE_URL=
TIKTOK_TOKEN_BASE_URL=
TIKTOK_API_BASE_URL=

LAZADA_APP_KEY=
LAZADA_APP_SECRET=
LAZADA_REDIRECT_URI=http://localhost:3000/marketplace/lazada/callback
LAZADA_SANDBOX=true
LAZADA_API_BASE_URL=

TIKI_CLIENT_ID=
TIKI_CLIENT_SECRET=
TIKI_REDIRECT_URI=http://localhost:3000/marketplace/tiki/callback
TIKI_SANDBOX=true
TIKI_AUTHORIZE_BASE_URL=
TIKI_TOKEN_URL=
TIKI_API_BASE_URL=

# AURELLE — sàn thứ 2, tự xây, Open API tương thích Lazada (xem
# AURELLE_MARKETPLACE_DESIGN.md). AURELLE_APP_SECRET dùng chung cho cả
# ký request LẪN verify chữ ký webhook (Mục 8.1).
AURELLE_APP_KEY=
AURELLE_APP_SECRET=
AURELLE_REDIRECT_URI=http://localhost:3000/marketplace/aurelle/callback
AURELLE_SANDBOX=true
AURELLE_AUTH_PAGE_BASE_URL=http://localhost:4000
AURELLE_AUTH_API_BASE_URL=http://localhost:4000/rest
AURELLE_API_BASE_URL=http://localhost:4000/rest
# Website AURELLE bắn webhook "đơn mới" tới đây (ký bằng AURELLE_APP_KEY/SECRET).
# Bỏ trống = mặc định http://localhost:$PORT/marketplace/webhooks/aurelle.
AURELLE_WEBHOOK_URL=
# seller_id của website trên Open API (mock + webhook dùng chung).
AURELLE_SELLER_ID=200000000101

# AI viết lời hướng dẫn đóng gói từng bước — Groq (key miễn phí tại console.groq.com).
# Để trống AI_API_KEY thì dùng câu mẫu, không lỗi.
AI_API_KEY=
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=openai/gpt-oss-120b
AI_TIMEOUT_MS=20000

# CP-SAT (microservice packer/) — chứng minh tối ưu đóng gói. Để trống PACKER_URL
# hoặc PACKER_ENABLED=false thì vẫn chạy (BRKGA), chỉ không có nhãn optimal_in_model.
# Chạy local: cd packer && .venv/Scripts/python -m uvicorn packer.main:app --port 8000
PACKER_URL=http://127.0.0.1:8000
PACKER_ENABLED=true
PACKER_TIMEOUT_MS=15000
PACKER_MAX_UNITS=12
PACKER_DET_TIME_PER_COMBO=1
PACKER_WALL_TIME_S=6

# Giới hạn request chung mỗi phút theo IP (mặc định 600).
THROTTLE_LIMIT_PER_MINUTE=600
# --- Đơn vị vận chuyển (08/10/2026) ---
# ghn_staging | ghn_production | mock (mock = không gọi mạng, phí mô phỏng)
CARRIER_MODE=ghn_staging
# Bật nút mô phỏng trạng thái giao trên màn Vận chuyển (chỉ dùng khi demo)
CARRIER_MANUAL_STATUS_ENABLED=true
# C4 (14/10/2026) — CHỈ DEMO: đơn Lazada bị che tỉnh / SĐT. Thiếu tỉnh -> tỉnh này; SĐT bị che -> SĐT này khi gửi GHN.
CARRIER_DEFAULT_PROVINCE=Hồ Chí Minh
CARRIER_DEMO_RECIPIENT_PHONE=0377168254
# 28/10/2026 — CHỈ DEMO: đơn bị che/thiếu địa chỉ (Lazada) dùng 1 địa chỉ mô phỏng (KHÔNG ghi DB — tính lại từ dữ liệu đơn).
# Số nhà = mẫu với {n} = CARRIER_DEMO_START_NUMBER + số đơn bị che tạo trước đơn đó; đơn đầu tiên dùng
# CARRIER_DEMO_RECIPIENT_PHONE, đơn sau SĐT 03x/09x sinh cố định theo mã đơn. Cả nhóm gộp dùng chung 1 địa chỉ. Đơn đủ địa chỉ (AURELLE) không bị ảnh hưởng.
# Phường phải là phường MỚI (sau 07/2025). GHN staging đã nhận "47/88 Nguyễn Văn Đậu" chỉ với Phường Gia Định
# (Bình Lợi Trung, Bình Thạnh → To address conflict; test 10/10 và 13/10/2026). Số nhà mô phỏng vẫn lệch → BE tự gửi lại không số nhà.
# Kiểm trước: npx ts-node -T -r dotenv/config scripts/ghn-check-demo-address.ts
CARRIER_DEMO_RECIPIENT_ENABLED=false
CARRIER_DEMO_STREET_TEMPLATE=47/{n} Nguyễn Văn Đậu
CARRIER_DEMO_START_NUMBER=10
CARRIER_DEMO_WARD=Phường Gia Định
CARRIER_DEMO_PROVINCE=Hồ Chí Minh
# Môi trường test: https://dev-online-gateway.ghn.vn — token lấy ở https://developer.ghn.dev (Manage token)
GHN_BASE_URL=https://dev-online-gateway.ghn.vn
GHN_TOKEN=
GHN_SHOP_ID=
GHN_DEFAULT_SERVICE_TYPE_ID=2
GHN_DEFAULT_REQUIRED_NOTE=CHOXEMHANGKHONGTHU
GHN_DEFAULT_PAYMENT_TYPE_ID=1
GHN_WEBHOOK_SECRET=
GHN_TIMEOUT_MS=10000
