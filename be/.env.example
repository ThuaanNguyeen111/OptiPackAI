# --- Server ---
PORT=3000
CORS_ORIGIN=http://localhost:5173
CLIENT_REDIRECT_CALLBACK=http://localhost:5173/oauth-success

# --- Database ---
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/optipackai?retryWrites=true&w=majority

# --- Redis (cache trạng thái auth) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- JWT ---
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=86400
JWT_REFRESH_EXPIRES_IN=2592000

# --- Google OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# --- Email (SMTP) ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM_NAME=OptiPackAI
MAIL_FROM_ADDRESS=
FRONTEND_URL=http://localhost:5173

# --- Marketplace Integration (TikTok Shop + Lazada + Tiki) ---
TOKEN_ENCRYPTION_KEY=
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

TIKTOK_APP_KEY=
TIKTOK_APP_SECRET=
TIKTOK_SANDBOX=true
# 3 dòng dưới CHỈ cần điền khi dùng mock server tools/tiktok-mock-server, để trống dùng domain thật
TIKTOK_AUTHORIZE_BASE_URL=
TIKTOK_TOKEN_BASE_URL=
TIKTOK_API_BASE_URL=

LAZADA_APP_KEY=
LAZADA_APP_SECRET=
LAZADA_REDIRECT_URI=http://localhost:3000/marketplace/lazada/callback
LAZADA_SANDBOX=true
LAZADA_API_BASE_URL=

TIKI_CLIENT_ID=
TIKI_CLIENT_SECRET=
TIKI_REDIRECT_URI=http://localhost:3000/marketplace/tiki/callback
TIKI_SANDBOX=true
TIKI_AUTHORIZE_BASE_URL=
TIKI_TOKEN_URL=
TIKI_API_BASE_URL=
